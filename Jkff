module JK_FF (JK, clock, q, module JK_ff_tb;

qb); reg [1:0] JK;

input [1:0] JK; reg clock;

input clock; wire q, qb;

output reg q, qb; JK_FF uut(JK, clock, q, qb);

always @ (posedge clock) initial

begin clock=1'b1;

case (JK) always #5 clock=~clock;

2'b00 : q = q; initial

2'b01 : q = 1'b0; begin

2'b10 : q = 1'b1; JK=2'b00; #20;

2'b11 : q =~ q; JK=2'b01; #20;

endcase JK=2'b10; #20;

qb =~ q; JK=2'b11; #50;

end end

endmodule

module JK_ff_tb;
reg [1:0] JK;
reg clock;
wire q, qb;
JK_FF uut(JK, clock, q, qb);
initial
clock=1'b1;
clock=~clock;
initial
begin
JK=2'b00; #20;
JK=2'b01; #20;
JK=2'b10; #20;
JK=2'b11; #50;
end
initial
$monitor ($time, "JK=%b q=%b qb=%b ", JK, q,qb);
endmodule
