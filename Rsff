module rs_ff(rs, clock, q, qb); 

input [1:0] rs;

input clock; 

output reg q, qb;

always @ (posedge clock) 

begin

case (rs) 

2'b00 : q = q ;

2'b01 : q = 1'b1 ;

2'b10 : q = 1'b0 ;

2'b11 : q = 1'dZ ;

endcase 

qb =~ q; 

end

endmodule

